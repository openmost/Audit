<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="bootstrap.php"
    colors="true"
    cacheResultFile=".phpunit.result.cache"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="audit-unit">
            <directory suffix="Test.php">./Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
